{
  "name": "@tabflow/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TabFlow UI-skal (M1): virtualiserat flöde, textblock, blockoperationer. Spårsagnostiskt UI.",
  "scripts": {
