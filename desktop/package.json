{
  "name": "@tabflow/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TabFlow Spår B — Electron-app med levande WebContentsView per sidblock (M4).",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.8",
    "dompurify": "^3.1.7",
    "marked": "^14.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^32.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
